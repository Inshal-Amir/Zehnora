# Zehnora platform API settings. Copy to .env (never commit .env).
ZEHNORA_PROFILE=mock                     # mock | dev-local-4b | gpu
ZEHNORA_DATABASE_URL=postgresql+psycopg://zehnora_platform:<password>@127.0.0.1:5433/zehnora_platform
ZEHNORA_LITELLM_BASE_URL=http://127.0.0.1:4000
ZEHNORA_LITELLM_MASTER_KEY=<LiteLLM master key, server secret>
ZEHNORA_PLAYGROUND_GATEWAY_KEY=<restricted LiteLLM key from: python -m app.cli create-gateway-key>
ZEHNORA_KEY_HMAC_SECRET=<openssl rand -hex 32>
ZEHNORA_SESSION_SECRET=<openssl rand -hex 32>
ZEHNORA_COOKIE_SECURE=false              # true behind HTTPS
ZEHNORA_CORS_ORIGINS=["http://127.0.0.1:5173"]
ZEHNORA_PUBLIC_API_BASE=http://127.0.0.1:8200/v1   # https://api.<OWNER_DOMAIN>/v1 in production
