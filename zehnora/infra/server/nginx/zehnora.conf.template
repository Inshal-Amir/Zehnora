# Zehnora public routing (behind the Cloudflare Tunnel; TLS terminates at Cloudflare's edge).
# console.${OWNER_DOMAIN}: portal static files + /platform/v1 (same origin, cookie sessions)
# api.${OWNER_DOMAIN}:     ONLY /v1/models and /v1/chat/completions (credit-enforcing platform layer)
# Everything else (LiteLLM, vLLM, databases, debug/health internals, desktop tools) is not routed.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 8080 default_server;
    server_name _;
    return 404;
}

server {
    listen 8080;
    server_name console.${OWNER_DOMAIN};
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location /platform/v1/ {
        proxy_pass http://platform-api:8200;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 600s;
    }
    location / {
        root /usr/share/nginx/portal;
        try_files $uri /index.html;
    }
}

server {
    listen 8080;
    server_name api.${OWNER_DOMAIN};
    client_max_body_size 4m;

    location = /v1/models {
        proxy_pass http://platform-api:8200;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location = /v1/chat/completions {
        proxy_pass http://platform-api:8200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        # SSE streaming: no buffering, long reads
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        chunked_transfer_encoding on;
    }
    location / {
        default_type application/json;
        return 404 '{"error":{"message":"Not found. Supported: GET /v1/models, POST /v1/chat/completions","type":"not_found_error","code":"not_found"}}';
    }
}
