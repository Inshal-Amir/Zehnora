# Copy to <repo>/.server-secrets/server.env on the GPU PC (WSL). Never commit the real file.
OWNER_DOMAIN=<OWNER_DOMAIN>                 # e.g. example.com -> console.example.com / api.example.com
ZEHNORA_MODEL_DIR=/home/<wsl-user>/zehnora-models   # SSD path OUTSIDE the repository

# Model engine: llamacpp (default; GGUF MoE, experts spill into system RAM) or vllm (safetensors, many users).
ZEHNORA_ENGINE=llamacpp

# Default model: Qwen3.6-35B-A3B (MoE, 3B active), Unsloth dynamic 4-bit GGUF, about 22.4 GB.
# On a 16 GB GPU the attention/shared layers stay in VRAM and the remaining experts use system RAM.
ZEHNORA_MODEL_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
ZEHNORA_MODEL_REVISION=a483e9e6cbd595906af30beda3187c2663a1118c
ZEHNORA_MODEL_SUBDIR=Qwen3.6-35B-A3B-GGUF-a483e9e
ZEHNORA_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
ZEHNORA_MODEL_SHA256=707a55a8a4397ecde44de0c499d3e68c1ad1d240d1da65826b4949d1043f4450
ZEHNORA_MAX_MODEL_LEN=65536                 # context window; the model supports up to 262144
ZEHNORA_MAX_NUM_SEQS=1                      # parallel requests served at once
ZEHNORA_REASONING=on                        # Qwen3.6 thinking mode (model card: coding/agentic sampling below)
ZEHNORA_TEMPERATURE=0.6
ZEHNORA_TOP_P=0.95
ZEHNORA_LLAMACPP_EXTRA_ARGS=
LLAMACPP_IMAGE_TAG=server-cuda-v0.4.1

# vLLM alternative (set ZEHNORA_ENGINE=vllm and replace the model lines above), e.g.
#   ZEHNORA_MODEL_REPO=Qwen/Qwen3-4B-Instruct-2507
#   ZEHNORA_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
#   ZEHNORA_MODEL_SUBDIR=Qwen3-4B-Instruct-2507-cdbee75
#   ZEHNORA_MODEL_FILE=                     # empty: download the whole safetensors snapshot
#   ZEHNORA_MAX_MODEL_LEN=4096
ZEHNORA_TOOL_PARSER=hermes                  # vllm only; verify: docker run --rm vllm/vllm-openai:v0.29.0 --help | grep -A3 tool-call-parser
ZEHNORA_GPU_MEM_UTIL=0.90                   # vllm only
ZEHNORA_VLLM_EXTRA_ARGS=
VLLM_IMAGE_TAG=v0.29.0
