# Copy to <repo>/.server-secrets/server.env on the GPU PC (WSL). Never commit the real file.
OWNER_DOMAIN=<OWNER_DOMAIN>                 # e.g. example.com -> console.example.com / api.example.com
ZEHNORA_MODEL_DIR=/home/<wsl-user>/zehnora-models   # SSD path OUTSIDE the repository
# Baseline (brief section 8): Qwen/Qwen3-4B-Instruct-2507 @ cdbee75f17c01a7cc42f958dc650907174af0554
ZEHNORA_MODEL_REPO=Qwen/Qwen3-4B-Instruct-2507
ZEHNORA_MODEL_REVISION=cdbee75f17c01a7cc42f958dc650907174af0554
ZEHNORA_MODEL_SUBDIR=Qwen3-4B-Instruct-2507-cdbee75
ZEHNORA_TOOL_PARSER=hermes                  # VERIFY on the PC: docker run --rm vllm/vllm-openai:v0.29.0 --help | grep -A3 tool-call-parser
# Challenger: Qwen/Qwen3.5-4B @ 851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a, parser qwen3_coder (per model card),
# text-only: ZEHNORA_VLLM_EXTRA_ARGS='--limit-mm-per-prompt {"image":0,"video":0}'  (verify flag on the pinned vLLM)
ZEHNORA_MAX_MODEL_LEN=4096                  # start at 4K; raise to 8K/16K only after measuring memory
ZEHNORA_MAX_NUM_SEQS=1
ZEHNORA_GPU_MEM_UTIL=0.90
ZEHNORA_VLLM_EXTRA_ARGS=
VLLM_IMAGE_TAG=v0.29.0
