# Roshvyn platform API settings. Copy to .env (never commit .env).
ROSHVYN_PROFILE=mock                     # mock | dev-local-4b | gpu
ROSHVYN_DATABASE_URL=postgresql+psycopg://roshvyn_platform:<password>@127.0.0.1:5433/roshvyn_platform
ROSHVYN_LITELLM_BASE_URL=http://127.0.0.1:4000
ROSHVYN_LITELLM_MASTER_KEY=<LiteLLM master key, server secret>
ROSHVYN_PLAYGROUND_GATEWAY_KEY=<restricted LiteLLM key from: python -m app.cli create-gateway-key>
ROSHVYN_KEY_HMAC_SECRET=<openssl rand -hex 32>
ROSHVYN_SESSION_SECRET=<openssl rand -hex 32>
ROSHVYN_COOKIE_SECURE=false              # true behind HTTPS
ROSHVYN_CORS_ORIGINS=["http://127.0.0.1:5173"]
ROSHVYN_PUBLIC_API_BASE=http://127.0.0.1:8200/v1   # https://api.<OWNER_DOMAIN>/v1 in production
